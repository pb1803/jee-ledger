# Supabase — copy this file to .env.local and fill in your project values.
# Get them from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Passcode gate (SERVER-ONLY). None of these use the NEXT_PUBLIC_ prefix, so
# they are never bundled into client/browser code. Keep them out of git.
# ---------------------------------------------------------------------------

# The 6-digit passcode shown on the lock screen (set the real value in .env.local).
JEE_APP_PASSCODE=000000

# A single, fixed Supabase auth user that the passcode gate signs in (using the
# anon key) to establish the RLS identity (auth.uid()). This is NOT the
# service-role key. It must already exist in your Supabase project.
JEE_APP_USER_EMAIL=student@example.com
JEE_APP_USER_PASSWORD=change-me
